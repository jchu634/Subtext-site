---
import Logo from "@/assets/Logo.svg";
import { Button } from "@/components/ui/shadcn/button";
import { ModeToggle } from "@/components/ui/ModeToggle";
import { motion } from "motion/react";
---

<div class="fixed h-20 w-full p-1 px-4 pt-5 md:px-8 lg:px-15">
  <div
    class="font-funnel flex h-full items-center justify-between space-x-2 rounded-2xl bg-[#1f4739] px-4"
  >
    <motion.a
      client:load
      className="flex items-center gap-2"
      href="/"
      whileTap={{ scale: 1.05 }}
      whileHover={{ scale: 1.05 }}
    >
      <img src={Logo.src} class="size-8" alt="Subtext Homepage" />

      <p class="font-lexend font-medium text-white">Subtext</p>
    </motion.a>
    <div class="flex gap-2">
      <ModeToggle client:load />
      <motion.div
        client:load
        whileTap={{ scale: 1.05 }}
        whileHover={{ scale: 1.05 }}
      >
        <Button
          className="cursor-pointer bg-[#f4a259] font-medium text-black hover:bg-[#ff5941] hover:text-white dark:bg-[#f4a259]"
        >
          <a href="/faq">FAQ</a>
        </Button>
      </motion.div>
      <motion.a
        client:load
        whileTap={{ scale: 1.05 }}
        whileHover={{ scale: 1.05 }}
        className="hidden items-center rounded-lg bg-gradient-to-r from-[#3245ff] to-[#bc52ee] px-3 font-semibold text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.12),inset_0_-2px_0_rgba(0,0,0,0.24)] transition-colors hover:text-gray-100 hover:shadow-none sm:flex"
        href="https://github.com/jchu634/Subtext-app/releases/latest/download/Subtext-Setup.exe"
        >Download Now</motion.a
      >
    </div>
  </div>
</div>
