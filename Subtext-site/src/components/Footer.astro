---
import GithubWhite from "@/assets/github-white.svg";
import LinkedInWhite from "@/assets/linkedin-white.png";
import CenterUnderline from "@/components/ui/text/underline-center";
import Image from "astro/components/Image.astro";
import { motion } from "motion/react";
---

<div
  class="font-funnel flex h-20 w-full items-center bg-[#1f4739] px-10 pl-10 text-white sm:justify-between"
>
  <div class="w-full">
    <p class="hidden sm:block">
      Subtext App: Local AI Subtitles (MIT Licensed)
    </p>
    <div class="flex justify-between sm:hidden">
      <p>Subtext: Local AI Subtitles</p>
      <p>©2025</p>
    </div>

    <div class="flex items-center gap-2">
      <p>Created by:</p>
      <motion.a
        client:load
        whileTap={{ scale: 1.05 }}
        whileHover={{ scale: 1.05 }}
        href="https://www.linkedin.com/in/jchu634/"
      >
        <Image src={LinkedInWhite} class="w-6" alt="Linkedin Logo" /></motion.a
      >
      <motion.a
        client:load
        whileTap={{ scale: 1.05 }}
        whileHover={{ scale: 1.05 }}
        href="https://github.com/jchu634"
        aria-label="Link to Author's Github"
      >
        <GithubWhite size="20" aria-label="Github Logo" />
      </motion.a>
      <a href="https://www.keshuac.com">
        <CenterUnderline client:load label="JCHU634" />
      </a>
    </div>
  </div>
  <p class="hidden sm:block">© 2025</p>
</div>
