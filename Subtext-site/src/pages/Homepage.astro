---
import { Image } from "astro:assets";
import background from "../assets/background.svg";
import ScreenshotDarkLarge from "@/assets/ScreenshotDarkLarge.png";
import ScreenshotLightLarge from "@/assets/ScreenshotLightLarge.png";
import ScreenshotDark from "@/assets/ScreenshotDark.png";
import ScreenshotLight from "@/assets/ScreenshotLight.png";
import Github from "@/assets/github.svg";
import { RotaryText } from "./HomepageRotaryText";
import { motion } from "motion/react";

const previewURL = new URL("/subtext", Astro.url);
---

<div
  class="flex min-h-screen px-8 font-sans sm:pt-5 md:px-13 md:pt-10 lg:pt-20 2xl:px-20"
>
  <Image
    src={background}
    class="fixed inset-0 -z-10 h-full w-full blur-[100px]"
    alt="background"
    fetchpriority="high"
  />
  <main class="flex w-full gap-8 pt-20">
    <section class="h-full w-full flex-col lg:w-1/2 xl:w-[45%]">
      <section class="w-fit">
        <h1 class="font-lexend text-[60px]">Subtext</h1>

        <RotaryText client:load />
      </section>

      <section class="font-funnel flex w-fit flex-wrap gap-4 pt-5 pl-1">
        <motion.a
          client:load
          whileTap={{ scale: 1.05 }}
          whileHover={{ scale: 1.05 }}
          className="flex items-center rounded-lg bg-gradient-to-r from-[#3245ff] to-[#bc52ee] px-3 py-2.5 font-semibold text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.12),inset_0_-2px_0_rgba(0,0,0,0.24)] transition-colors hover:text-gray-100 hover:shadow-none"
          href="https://github.com/jchu634/Subtext-app/releases/latest/download/Subtext-Setup.exe"
          >Download Now</motion.a
        >
        <motion.a
          client:load
          whileTap={{ scale: 1.05 }}
          whileHover={{ scale: 1.05 }}
          className="flex items-center gap-x-2 rounded-lg bg-gray-300 px-3 py-2.5 text-gray-900 transition-colors hover:text-gray-600"
          href="https://github.com/jchu634/Subtext-app"
        >
          <p>Github Repo</p>

          <Github size="30" />
        </motion.a>
      </section>
      <section class="flex items-center space-x-2 pt-10">
        <h3 class="font-lexend text-[20px]">v1.2.1 Released</h3>
        <motion.a
          client:load
          whileTap={{ scale: 1.05 }}
          whileHover={{ scale: 1.05 }}
          className="rounded-md bg-yellow-500 bg-gradient-to-r px-4 py-2 text-left font-semibold text-zinc-700 dark:bg-yellow-400"
          href="/release-notes">Release Notes</motion.a
        >
      </section>
      <section class="block items-center pt-10 lg:hidden">
        <motion.div
          client:load
          whileTap={{ scale: 1.05 }}
          whileHover={{ scale: 1.05 }}
        >
          <Image
            src={ScreenshotLight}
            alt="A screenshot of the subtext application"
            class="relative block w-full dark:hidden"
          />
          <Image
            src={ScreenshotDark}
            alt="A screenshot of the subtext application"
            class="relative hidden w-full dark:block"
          />
        </motion.div>
      </section>
    </section>
    <section class="hidden w-1/2 items-center lg:block xl:w-[55%]">
      <motion.div
        className="block 2xl:hidden"
        client:load
        whileTap={{ scale: 1.05 }}
        whileHover={{ scale: 1.05 }}
      >
        <Image
          src={ScreenshotLightLarge}
          alt="A screenshot of the subtext application"
          class="relative block w-full dark:hidden"
        />
        <Image
          src={ScreenshotDarkLarge}
          alt="A screenshot of the subtext application"
          class="relative hidden w-full dark:block"
        />
      </motion.div>
      <iframe
        src={previewURL.toString()}
        class="hidden h-4/5 w-full border-none 2xl:block"
        title="Subtext UI Demo"
      >
      </iframe>
    </section>
  </main>
</div>
